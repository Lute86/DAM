<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradient_background"
    android:gravity="center"
    android:padding="16dp">

    <TextView
        android:id="@+id/editTextPrecio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Cobros"
        android:textColor="#19181B"
        android:textSize="24sp" />

    <Spinner
        android:id="@+id/spinnerServicio"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:hint="Servicio..."
        android:backgroundTint="@android:color/holo_purple"/>

    <Spinner
        android:id="@+id/spinnerTipoPago"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:hint="Tipo de Pago"
        android:backgroundTint="@android:color/holo_purple"/>

    <EditText
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:hint="Precio"
        android:inputType="numberDecimal"
        android:backgroundTint="@android:color/holo_purple"/>

    <Button
        android:id="@+id/btnCobrar"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:text="COBRAR"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:backgroundTint="@android:color/holo_purple"
        android:background="@drawable/button_background"/>

    <Button
        android:id="@+id/btnVolver"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:text="Volver"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="@android:color/holo_blue_dark"
        android:background="@drawable/button_background_exit"/>

</LinearLayout>
