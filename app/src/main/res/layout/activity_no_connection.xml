<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:padding="16dp">

    <TextView
        android:id="@+id/textViewError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="100dp"
        android:layout_marginBottom="10dp"
        android:text="Oops...\nalgo ha ido mal"
        android:textAlignment="center"
        android:textColor="#040405"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/textViewErrorDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Revisa tu conexión"
        android:textColor="#19181B"
        android:textSize="16sp"
        android:textAlignment="center"
        android:layout_below="@id/textViewError"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="100dp"
        />

    <ImageView
        android:id="@+id/imageViewError"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/connection_background"
        android:layout_below="@id/textViewErrorDetails"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="30dp"/>

    <Button
        android:id="@+id/btnRetry"
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:text="Reintentar"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#9C27B0"
        android:layout_below="@id/imageViewError"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"/>

</RelativeLayout>
